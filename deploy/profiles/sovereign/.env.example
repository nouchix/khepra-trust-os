# KTOS sovereign profile — required image pins.
#
# Copy to `.env` beside the compose file and fill in DIGESTS, not tags:
#   cp .env.example .env
#
# Every variable below is declared with ${VAR:?...} in docker-compose.yml, so
# compose REFUSES TO START when one is missing. That is deliberate: an unpinned
# deployment cannot produce replayable evidence, because you cannot say later
# which bytes ran. Guard G-2 (ops/guards/module_boundary_guard.sh) enforces the
# same rule at CI time.
#
# Resolve a digest for a tag with:
#   docker buildx imagetools inspect ghcr.io/nouchix/adinkhepra:v0.1.0 \
#     --format '{{.Manifest.Digest}}'
# or, without pulling:
#   crane digest ghcr.io/nouchix/adinkhepra:v0.1.0
#
# See docs/architecture/ARCH-014-production-release-topology.md §5 for how the
# release workflow records these into the release manifest.

# ── Consumed artifacts: built by their own repos, pinned here ────────────────

# Adinkhepra-ASAF → compliance graph API (the ASAF data plane, :8443)
ASAF_API_IMAGE=ghcr.io/nouchix/adinkhepra@sha256:REPLACE_ME

# Adinkhepra-ASAF → Next.js compliance graph UI
# NOTE: this image is built against a cloud Supabase project (build-time
# NEXT_PUBLIC_SUPABASE_* args). See ARCH-014 §7 — open sovereignty gap.
ASAF_UI_IMAGE=ghcr.io/nouchix/adinkhepra-ui@sha256:REPLACE_ME

# PQC-Khepra-MCP (PUBLIC repo) → the 72-tool MCP kernel.
# This is the ONLY dependency khepra-trust-os has on the public repo, and it is
# an artifact dependency. No submodule, no Go import — see ARCH-014 §3.
KHEPRA_MCP_IMAGE=ghcr.io/nouchix/pqc-khepra-mcp@sha256:REPLACE_ME

# Third-party sovereign LLM runtime. Air-gapped sites should re-point this at
# their internal mirror.
OLLAMA_IMAGE=ollama/ollama@sha256:REPLACE_ME

# ── Built from this repo ────────────────────────────────────────────────────

# The KTOS core toolbox (ktos-aiscan / ktos-mcp / ktos-enforce). Optional: its
# bytes are determined by this git commit, so the local build default is fine
# for development. Set it to a released digest for a customer deployment.
# KTOS_CORE_IMAGE=ghcr.io/nouchix/ktos-core@sha256:REPLACE_ME

# ── Model bootstrap (optional) ───────────────────────────────────────────────
# asaf-network is internal:true, so the running stack cannot reach a model
# registry. Seed the ollama-models volume once, from a connected host:
#   docker compose --profile bootstrap run --rm ollama-bootstrap
# Space-separated; defaults to llama3.1:8b when unset.
#OLLAMA_BOOTSTRAP_MODELS=llama3.1:8b
