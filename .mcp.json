{
  "_comment": "KHEPRA Trust OS, PQC-Khepra-MCP, Hostinger & Cloudflare Integration Config",
  "mcpServers": {
    "pqc-khepra-mcp": {
      "_comment": "Post-Quantum Cryptography MCP Kernel Server",
      "command": "bash",
      "args": [
        "-c",
        "cd /Applications/Whitebox/PQC-Khepra-MCP && GOWORK=off exec go run ./cmd/khepra-mcp"
      ],
      "env": {
        "KHEPRA_MODE": "sovereign",
        "KHEPRA_NETWORK_POLICY": "lan",
        "MCP_PQC_ENABLED": "true"
      }
    },
    "ktos-mcp": {
      "_comment": "KTOS Trust Plane MCP Server (AEOs, Agent Passports, Trust Scores, Attestation)",
      "command": "bash",
      "args": [
        "-c",
        "cd /Applications/Whitebox/khepra-trust-os/core && GOWORK=off GOFLAGS=-mod=vendor exec go run ./cmd/ktos-mcp"
      ],
      "env": {
        "KHEPRA_MODE": "sovereign",
        "KHEPRA_NETWORK_POLICY": "lan",
        "MCP_PQC_ENABLED": "true"
      }
    },
    "hostinger-mcp": {
      "_comment": "Hostinger MCP Server for Domain DNS, Hosting, and VPS Management",
      "command": "npx",
      "args": [
        "-y",
        "@hostinger/mcp-server"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      }
    },
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare-bindings": {
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      }
    },
    "cloudflare-builds": {
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      }
    },
    "cloudflare-observability": {
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      }
    }
  }
}
